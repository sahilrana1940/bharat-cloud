'use client'
import { useState } from 'react'

export default function Page() {
  const [msg, setMsg] = useState("Ready to backup")

  async function upload(e:any) {
    const file = e.target.files[0]
    if(!file) return
    setMsg("Mumbai Vault me bhej raha hu...")
    const fd = new FormData()
    fd.append('file', file)
    const res = await fetch('/api/upload', { method: 'POST', body: fd })
    const data = await res.json()
    setMsg(data.msg || "Ho gaya!")
  }

  return (
    <div style={{background:'#000', color:'#fff', minHeight:'100vh', padding:40}}>
      <h1 style={{color:'#38bdf8'}}>Bharat-Cloud | Super Admin</h1>
      <p>Client: Akhnoor Wale | Plan: ₹24,950/yr</p>
      <br/>
      <h2>🔴 Backup All Now (Wasabi 100GB Trial)</h2>
      <input type="file" onChange={upload} style={{marginTop:20}} />
      <h3 style={{color:'#22c55e', marginTop:20}}>{msg}</h3>
      <br/><hr/><br/>
      <p>✅ Domain: bharatcloud.store LIVE</p>
      <p>✅ Vault: Wasabi Connected</p>
    </div>
  )
}